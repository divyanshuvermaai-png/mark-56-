# ==============================================================================
# J.A.R.V.I.S. Mark 56 - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required - get one from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Alpha Vantage API Key (for real-time stock quotes & currency exchange rates)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Live Model (gemini-3.8-live is the verified active model for low-latency audio)
GEMINI_MODEL=gemini-3.8-live

# Prebuilt voice name:
# Options: Charon (Deep, articulate, informative - recommended for JARVIS),
#          Sadaltager (Knowledgeable), Fenrir (Crisp), Puck, Kore, Aoede
VOICE_NAME=Charon

# Title JARVIS uses to address you (e.g. Sir, Boss, Tony, etc.)
USER_TITLE=Divyanshu Sir

# Audio Hardware Device Selection:
# Leave blank to use system defaults (MacBook Mic / Speakers, or ALSA / Pulse default on Linux).
# To route output through laptop AUX jack connected to boAt Stone 350 Pro, you can specify:
#   AUDIO_OUTPUT_DEVICE=default
# Or specify device index / name substring from 'python run.py' output list (e.g. AUDIO_OUTPUT_DEVICE=hw:0,0)
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# Local Wake-Word Engine ('Jarvis' or 'Hey Jarvis'):
# If True, detection runs strictly LOCALLY on CPU while idle.
# Zero audio is transmitted over the network until activated.
# If False, continuously streams audio (push-to-talk/ambient).
WAKE_WORD_ENABLED=true
WAKE_WORD_THRESHOLD=0.5

# Inactivity timeout (in seconds) before returning from active conversation to local idle mode
CONVERSATION_TIMEOUT=12.0

# Echo suppression / half-duplex mode:
# If you are wearing headphones (recommended), leave this False for full-duplex interruption.
# If you are using external speakers (boAt Stone 350 Pro) without headphones,
# set to True to prevent the microphone from picking up JARVIS's voice.
MUTE_MIC_DURING_SPEECH=false

# Whether JARVIS speaks a welcome greeting when launched
ENABLE_STARTUP_GREETING=true

# Live Search Grounding:
# Set to 'false' (default) to use built-in live web search (via DuckDuckGo) which requires no billing.
# Set to 'true' only if your Gemini API key / Google Cloud Project has paid billing enabled for Google Search grounding.
USE_GOOGLE_SEARCH_GROUNDING=false

